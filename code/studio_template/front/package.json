{
  "name": "front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React 18 + Vite + TypeScript + React Router 前台。只透過 @studio/api-client 呼叫後端。",
  "scripts": {
    "dev": "vite --port 4100 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4100 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@studio/api-client": "workspace:*",
    "@studio/demo-world": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@studio/guard-kit": "workspace:*",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "msw": "^2.8.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
