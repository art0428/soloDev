# 正式機需要的變數「名稱」。值不放這裡，也不貼進任何對話。
# 本機開發用的是 backend/.env.example 與 front/.env.example（scripts/init.sh 會複製成 .env）。
#
# 分三段，標記行不要改（守衛測試 backend/src/guards/env-files.test.ts 靠它們比對）：
#   [env]    後端一般環境變數，gcloud run deploy 用 --set-env-vars 帶
#   [secret] 後端密鑰，放 Secret Manager（名稱與變數同名），gcloud run deploy 用 --set-secrets 帶
#   [build]  前台建置期變數，pnpm --filter front run build 時帶，會燒進靜態檔，所以絕不放密鑰
#
# NODE_ENV、HOST、PORT、TZ 由 deploy/Dockerfile.backend 設好，這裡不要再設。

# [env]
AUTH_MODE=mcc
# https://<API 網域>。正式環境必填且要 https（env.ts 會擋）
API_URL=
# https://<前台網域>。登入後導回與 CORS 允許都看它
FRONT_URL=
# 前台與 API 是同一個網站（例 app.example.com 與 api.example.com）用 lax；網域完全不同才改 none
COOKIE_SAME_SITE=lax
BUSINESS_TZ=Asia/Taipei
SESSION_TTL_HOURS=12
LOG_LEVEL=info
# 這次部署的 tag，例 prod/v3。/health 會回，部署後用來確認上的是哪一版
APP_VERSION=
MCC_ISSUER=https://members.managers.center
# 正式 Group 的 Service suuid（不是人看得懂的名字）
MCC_CLIENT_ID=
MCC_SERVICE_CODE=
# 留空＝ API_URL + /auth/callback。要一字不差登記在正式 Group 的白名單
MCC_REDIRECT_URI=

# [secret]
DATABASE_URL=
SESSION_SECRET=
MCC_CLIENT_SECRET=
MCC_GROUP_JWT=

# [build]
# API 網址。留空＝跟前台同一個網址（負載平衡器把 /api、/auth 導到後端）
VITE_API_URL=
VITE_APP_NAME=
