# 複製成 backend/.env 後填值。.env 不進 git。值不要貼進任何對話。
# scripts/init.sh 會檢查每一個變數都有值，並在 SESSION_SECRET 空白時自動產生。

NODE_ENV=development
HOST=127.0.0.1
PORT=4200
LOG_LEVEL=info

# 本機開發庫。資料庫名建議「<專案名>_dev」；測試一律走 scripts/run-tests.sh 的拋棄式庫，不會碰這一個。
# Prisma 一定要有帳號（psql 可以省，Prisma 不行）；本機免密碼就只寫帳號。
DATABASE_URL=postgresql://<帳號>:<密碼>@localhost:5432/<專案名>_dev?schema=public

# Cookie Session 加密，至少 32 字元隨機字串（init.sh 會用 openssl rand -base64 48 產生）
SESSION_SECRET=
SESSION_TTL_HOURS=12

# mock（假登入，只准本機與測試；正式環境啟動時會擋）或 mcc（真實登入）
AUTH_MODE=mock

# 後端自己的對外網址與前台網址（登入後導回、CORS 允許）
API_URL=http://127.0.0.1:4200
FRONT_URL=http://127.0.0.1:4100
# 前台與後端不同網域時改 none（Cookie 才送得過去），同網域維持 lax
COOKIE_SAME_SITE=lax

# 業務時區（IANA 名稱）
BUSINESS_TZ=Asia/Taipei

# MCC（members.managers.center）。AUTH_MODE=mcc 時必填前兩個。
# 開發與測試用「測試 Group」的憑證，正式機用「正式 Group」；網址都一樣。
MCC_ISSUER=https://members.managers.center
MCC_CLIENT_ID=
MCC_CLIENT_SECRET=
MCC_GROUP_JWT=
MCC_SERVICE_CODE=
# 留空＝ API_URL + /auth/callback。要一字不差登記在對應 Group 的白名單。
MCC_REDIRECT_URI=
