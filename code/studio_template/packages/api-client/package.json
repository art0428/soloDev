{
  "name": "@studio/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "由 api/openapi.yaml 產生的型別與呼叫器。src/schema.d.ts 不手改，改契約後 pnpm openapi:gen。",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi.yaml -o src/schema.d.ts --alphabetize",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.0",
    "typescript": "^5.8.0"
  }
}
